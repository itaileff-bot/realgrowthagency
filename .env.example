# Real Growth Agency: Owner Admin + Marketing Management
# Set these in Vercel > Project > Settings > Environment Variables (Production and Preview).
# The public site works without them; the admin area stays disabled until all required values are valid.

# --- Required: owner login ---
# Random 32+ character secret that signs the session cookie. Generate: openssl rand -base64 48
ADMIN_SESSION_SECRET=
# Comma separated owner emails allowed to sign in. The developer address is always included.
ADMIN_OWNER_EMAILS=itai@cpg-advisory.com
# scrypt hash of the owner password. Generate locally: npm run admin:hash-password
ADMIN_PASSWORD_HASH=

# --- Required: Firebase Admin (service account from Firebase console > Project settings > Service accounts) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full PEM including BEGIN/END lines; \n sequences are converted automatically.
FIREBASE_PRIVATE_KEY=

# --- Optional: Gemini drafting mode (template mode needs nothing) ---
GEMINI_API_KEY=
MARKETING_AI_MODEL=gemini-2.5-flash

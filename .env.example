# Real Growth Agency: Owner Admin + Marketing Management
# Set these in Vercel > Project > Settings > Environment Variables (Production and Preview).
# The public site works without them; the admin area stays disabled until all required values are valid.

# --- Required: owner login ---
# Random 32+ character secret that signs the session cookie. Generate: openssl rand -base64 48
ADMIN_SESSION_SECRET=
# Comma separated owner emails allowed to sign in. The developer address is always included.
ADMIN_OWNER_EMAILS=itai@cpg-advisory.com
# scrypt hash of the owner password. Generate locally: npm run admin:hash-password
ADMIN_PASSWORD_HASH=

# --- Required: Firebase Admin (service account from Firebase console > Project settings > Service accounts) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full PEM including BEGIN/END lines; \n sequences are converted automatically.
FIREBASE_PRIVATE_KEY=

# --- Optional: Gemini drafting mode (template mode needs nothing) ---
GEMINI_API_KEY=
MARKETING_AI_MODEL=gemini-2.5-flash

# --- Optional: paid website training (Stripe Checkout) ---
# Without these the training page shows "Book a call to enrol" instead of a pay button.
# Stripe dashboard > Developers > API keys. Use the test key (sk_test_...) on Preview first.
STRIPE_SECRET_KEY=
# Stripe dashboard > Developers > Webhooks > Add endpoint:
#   URL: https://www.realgrowthagency.com/api/stripe/webhook
#   Events: checkout.session.completed, checkout.session.async_payment_succeeded
# Then copy the endpoint's signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=

# --- Optional: email through AWS SES (manual delivery, lead and order notifications) ---
# Set all four or none. SES_FROM_EMAIL must be a verified SES identity.
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
# Where new lead and order notifications go. Defaults to the first ADMIN_OWNER_EMAILS address.
LEAD_NOTIFY_EMAIL=

# Note: the free manual form saves leads to Firestore when the Firebase Admin values above are set.
# Until then it posts to the same form relay as the contact form.

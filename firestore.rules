rules_version = '2';
// Real Growth Agency: all data is written and read by the server through the
// Firebase Admin SDK, which bypasses these rules. Browser clients get nothing:
// marketingManagementRuns, auditLogs and rateLimits are server-only.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
